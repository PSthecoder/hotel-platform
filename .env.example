# Copy to server/.env and fill in. NEVER commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_dev
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TTL=15m
REFRESH_DAYS=7
BCRYPT_COST=12
CORS_ORIGIN=http://localhost:5173
USD_INR_RATE=83
# Seed admin (used by npm run seed). Required in production.
ADMIN_EMAIL=admin@hotel.test
ADMIN_PASSWORD=ChangeMe123
# Uploads
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
# Stretch: queue + email (optional; without REDIS_URL jobs run in-process)
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hotel Platform <no-reply@example.com>"
